# Copy this file to `.streamlit/secrets.toml` (or set the same names as environment
# variables) to point the dashboard at a real Supabase project instead of the
# local synthetic CSVs. When these are absent, the app runs entirely on local data.
#
# The table names in Supabase must match the CSV names:
#   properties, rent_roll, work_orders, leasing_funnel, applications, leads

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-or-service-key"
